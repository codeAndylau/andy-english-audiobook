{
  "chapterId": 1,
  "sentences": {
    "1-1": "我的包放在门外。",
    "1-2": "我手里拿着手机。",
    "1-3": "4B号公寓。",
    "1-4": "我又核对了一遍门牌号。",
    "1-5": "然后敲了敲门。",
    "1-6": "一位女士打开了门。",
    "1-7": "她一只手里拿着一个蓝色杯子。",
    "1-8": "“Andy？”",
    "1-9": "“是的。",
    "1-10": "你好。",
    "1-11": "我是Andy。”",
    "1-12": "“我是Maya。",
    "1-13": "进来吧。”",
    "1-14": "我提起包，跟着她走进去。",
    "1-15": "公寓里飘着咖啡的香味。",
    "1-16": "窗边摆着两把椅子，中间是一张小桌子。",
    "1-17": "其中一把椅子上放着几本书。",
    "1-18": "“不好意思，书还没收，”Maya说。",
    "1-19": "“你的房间在这边。”",
    "1-20": "房间不大，不过有一张书桌。",
    "1-21": "我把包放在床边。",
    "1-22": "“还可以吗？”她问。",
    "1-23": "“可以。",
    "1-24": "挺好的。”",
    "1-25": "我还有些事想问。",
    "1-26": "我的食物可以放在哪里？",
    "1-27": "洗衣机能用吗？",
    "1-28": "厨房里为什么有个水桶？",
    "1-29": "但Maya的手机响了。",
    "1-30": "她看了一眼屏幕，把铃声关了。",
    "1-31": "“不好意思。",
    "1-32": "工作电话。”",
    "1-33": "“没关系。”",
    "1-34": "我们回到厨房。",
    "1-35": "“喝茶吗？”她问。",
    "1-36": "“好，谢谢。”",
    "1-37": "“加奶吗？”",
    "1-38": "“不加，谢谢。”",
    "1-39": "很好。",
    "1-40": "这些我能应付。",
    "1-41": "Maya把一杯茶放到我面前。",
    "1-42": "接着，她指了指水桶。",
    "1-43": "“厨房水龙头坏了。",
    "1-44": "明天八点到十二点之间会有人来修。",
    "1-45": "你能在家等一下吗？",
    "1-46": "我得去办公室。”",
    "1-47": "我听到了“明天”。",
    "1-48": "我听到了“八点”。",
    "1-49": "“可以，”我说。",
    "1-50": "Maya拿起手机。",
    "1-51": "“太好了。",
    "1-52": "谢谢你。”",
    "1-53": "我看着水桶。",
    "1-54": "一滴水落了进去。",
    "1-55": "接着又是一滴。",
    "1-56": "我明天十点有个会。",
    "1-57": "去办公室要四十分钟。",
    "1-58": "也许师傅八点就会来。",
    "1-59": "也许十分钟就能修好。",
    "1-60": "也许我该问清楚。",
    "1-61": "Maya开始打字。",
    "1-62": "“不好意思，”我说。",
    "1-63": "她抬起头。",
    "1-64": "“你能再说一遍吗？",
    "1-65": "具体是几点？”",
    "1-66": "“八点到十二点之间。”",
    "1-67": "“八点到十二点，”我重复道。",
    "1-68": "“也就是说，也可能是十一点？”",
    "1-69": "“对。",
    "1-70": "还没有确切时间。”",
    "1-71": "“哦。",
    "1-72": "不好意思。",
    "1-73": "我九点就得出门。”",
    "1-74": "Maya放下手机。",
    "1-75": "“这样啊。”",
    "1-76": "一时间，我们谁也没说话。",
    "1-77": "“我可以待到九点，”我说。",
    "1-78": "“这样行吗？”",
    "1-79": "“恐怕不行。",
    "1-80": "他可能晚一点才来。”",
    "1-81": "我的脸有点发烫。",
    "1-82": "我低头看着茶。",
    "1-83": "然后试着换个问题。",
    "1-84": "“他能下午来吗？”",
    "1-85": "Maya看了看手机。",
    "1-86": "“不知道。",
    "1-87": "我问问。”",
    "1-88": "她发了一条消息。",
    "1-89": "我把杯子往里挪了挪，离桌边远一点。",
    "1-90": "一分钟后，她的手机响了一声。",
    "1-91": "“两点到四点，”她说。",
    "1-92": "“那时候我能在家。”",
    "1-93": "“那我就不用留下了？”",
    "1-94": "“对。”",
    "1-95": "“好。",
    "1-96": "给你添麻烦了。”",
    "1-97": "“没事。”",
    "1-98": "她拿起杯子。",
    "1-99": "“不确定的时候直接跟我说就好。”",
    "1-100": "她的手机又响了。",
    "1-101": "“这个电话我得接。",
    "1-102": "就当自己家，随意一点。”",
    "1-103": "“谢谢。”",
    "1-104": "她朝自己的房间走去。",
    "1-105": "我看了看窗边的两把椅子。",
    "1-106": "又看了看那些书。",
    "1-107": "“Maya？”",
    "1-108": "“怎么了？”",
    "1-109": "“这些书我可以挪一下吗？”",
    "1-110": "“当然可以。",
    "1-111": "放桌上就行。”",
    "1-112": "我把书挪开，坐了下来。",
    "1-113": "茶还是温的。"
  }
}
